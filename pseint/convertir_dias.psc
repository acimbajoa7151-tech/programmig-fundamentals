Algoritmo convertir_dias
	Definir dias, horas, minutos, segundos Como Real
	Escribir "Ingrese la cantidad de días:"
    Leer dias
	horas <- dias * 24
    minutos <- dias * 24 * 60
    segundos <- dias * 24 * 60 * 60
	Escribir "Cantidad de horas: ", horas
    Escribir "Cantidad de minutos: ", minutos
    Escribir "Cantidad de segundos: ", segundos
	FinAlgoritmo
