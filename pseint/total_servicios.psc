Algoritmo total_servicios
	Definir energia, agua, gas, internet, total Como Real
	Escribir "Ingrese el valor de energía:"
    Leer energia
	Escribir "Ingrese el valor de agua:"
    Leer agua
	Escribir "Ingrese el valor de gas:"
    Leer gas
	Escribir "Ingrese el valor de internet:"
    Leer internet
	total <- energia + agua + gas + internet
	Escribir "El valor total a pagar es: ", total
FinAlgoritmo
